# Example .env file
# Make a copy of this file and rename it to .env
# Never push the .env file to Github!

# This file contains all the computer-specific environment variables to make the model run.
# Most values will not need changed (such as snowserver or PetaLibrary filepaths) unless the actual
# file structure changes. Other values such as the CU Research Computing identikey are user-specific
# and will need to be modified before running the model for the first time. Anything that must be
# changed has been marked with "CHANGE THIS".

##### fSCA #####
# Path to the parent directory of fSCA data on snowserver
LOCAL_FSCA_PATH=H:/WestUS_Data/Rittger_data/fsca_v2025.0.1_ops/NRT_NetCDFs/netcdf
# Path to the directory containing processed fSCA tifs
PROCESSED_FSCA_PATH=H:/WestUS_Data/Rittger_data/fsca_v2025.0.1_ops/NRT_FSCA_WW_N83/
# Path to the directory containing DMFSCA files
DMFSCA_PATH=H:/WestUS_Data/Rittger_data/fsca_v2025.0.1_ops/NRT_DMFSCA_WW_N83/
# List of tiles to download and process
FSCA_TILES=h08v04,h08v05,h09v04,h09v05,h10v04
# Sinusoidal MODIS projection for fSCA processing
SIN_MODIS_PROJ=M:/SWE/WestWide/data/basemap/CoordinateSystems/Sinusodial_MODIS_custom_ET.prj
# fSCA processing snap raster
FSCA_SNAP_RASTER=M:/SWE/WestWide/data/boundaries/SnapRaster_geon83.tif
# fSCA processing extent
FSCA_EXTENT=M:/SWE/WestWide/data/boundaries/Margulis_domain_geon83.shp
# Path to the mean layer workspace
MEAN_LAYER_WORKSPACE=H:/WestUS_Data/Regress_SWE/HistoricalDaily_mask/
# Path to the mean layer output folder
MEAN_LAYER_OUTPUT=W:/Spatial_SWE/WW_regression/mean_2000_2025_WY26_glacMask/
# Mean layer start and end years
MEAN_LAYER_START_YEAR=2000
MEAN_LAYER_END_YEAR=2025

# PetaLibrary (ssh method)
# Path the parent directory of fSCA data on PetaLibrary
CURC_FSCA_PATH=/pl/active/rittger_ops/output/mod09ga.061/spires/v2025.0.1/netcdf
# PetaLibrary FTP host address (https://curc.readthedocs.io/)
CURC_HOST=dtn.rc.colorado.edu
# The CU identikey used to create the CILogon account with your ssh key (CHANGE THIS)
CURC_IDENTIKEY=abcd1234

# Snow Today (ftp method)
# These values are from https://nsidc.org/snow-today/get-snow-data
# Path to the parent directory of fSCA data on Snow Today
SNOW_TODAY_FSCA_PATH=/shares/snow-today/gridded_data/SPIRES_NRT_V02/
# Snow Today FTP host address
SNOW_TODAY_HOST=dtn.rc.colorado.edu
# Snow Today FTP Login Information
SNOW_TODAY_USERNAME=anonymous
SNOW_TODAY_PASSWORD=pwd

##### SNODAS #####
# Path to the parent directory of SNODAS data on snowserver
SNODAS_LOCAL_PATH=W:/Spatial_SWE/NOHRSC
# Path to the parent directory of SNODAS data on NSIDC server
SNODAS_REMOTE_PATH=/DATASETS/NOAA/G02158/masked
# SNODAS FTP host address
SNODAS_HOST=sidads.colorado.edu

##### SnowTrax #####
# Path to the parent directory of the SnowTrax SWE data
SNOWTRAX_PATH=J:/Spatial_SWE/SNM_regression/RT_report_data
# Name of the SnowTrax SWE data file
SNOWTRAX_FILENAME=wsfr_snow.csv

##### MODIS #####
# Bounding Box for MODIS true color imagery in decimal degrees (min_lon, min_lat, max_lon, max_lat)
# -123.2,34,-117,42.1 covers the extent of Figure 5 in the SNM reports
MODIS_BBOX=-123.2,34,-117,42.1
# Path within the RT_Report folder where MODIS imagery will be saved
MODIS_PATH=/MODIS

##### SNOW SENSOR #####
# Path to where snow sensor data is downloaded
SENSOR_PATH=H:/WestUS_Data/Regress_SWE/snow_sensors
# File within the SENSOR_PATH folder containing a list of all sensors
SENSOR_LIST=0MasterSensors.csv