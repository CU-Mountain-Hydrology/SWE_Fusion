WW_WATERSHED_SHAPEFILE=W:/data/hydro/20260113_BasinUpdatesNoSNM/WW_Basins_noSNM_notahoe_albn83_sel_v2_dis.shp
SNM_WATERSHED_SHAPEFILE=M:/SWE/WestWide/data/hydro/SNM/dwr_basins_albn83_GT5000.shp
WW_BAND_SHAPEFILE=W:/data/hydro/20260113_BasinUpdatesNoSNM/WW_BasinsBanded_noSNM_notahoe_albn83_sel_v2_updated_20260208.shp
SNM_BAND_SHAPEFILE=M:/SWE/WestWide/data/hydro/SNM/dwr_band_basins_albn83_delin.shp

##### ArcGIS Projection Spatial References #####
# Use with arcpy.SpatialReference(cfg.proj_xxx)
# NAD 1983
PROJ_GEO=4269
# USA Contiguous Albers Equal Area Conic (USGS version)
PROJ_ALB=102039
# NAD 1983 / UTM Zone 11N (Nevada)
PROJ_UTM=26911