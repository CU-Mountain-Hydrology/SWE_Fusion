CASE_FIELD_WATERSHED=SrtName
CASE_FIELD_BAND=SrtNmeBand
# Masks
WATER_MASK=M:/SWE/WestWide/data/mask/watermask_outdated/outdated/WW/Albers/WW_watermaks_10_albn83_clp_final.tif
GLACIER_MASK=M:/SWE/WestWide/data/mask/glacierMask/glims_glacierMask_null_GT10_final.tif
SNM_DOMAIN_MASK=M:/SWE/WestWide/data/hydro/SNM/dwr_mask_null_albn83.tif
#
WW_SNAP_RASTER_GEON83=M:/SWE/WestWide/data/boundaries/SnapRaster_geon83.tif
WW_SNAP_RASTER_ALBN83=M:/SWE/WestWide/data/boundaries/SnapRaster_albn83.tif
SNM_SNAP_RASTER_ALBN83=M:/SWE/WestWide/data/boundaries/SNM_SnapRaster_albn83.tif
