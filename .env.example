MEAN_WORKSPACE=M:/SWE/WestWide/Spatial_SWE/WW_regression/mean_2000_2025_WY26_glacMask/
#
WW_WATERSHED_ZONES=W:/data/hydro/20260113_BasinUpdatesNoSNM/WW_BasinBanded_noSNM_notahoe_albn83_sel_v2_updated.tif
SNM_WATERSHED_ZONES=M:/SWE/WestWide/data/hydro/SNM/dwr_basins_geoSort_albn83.tif
#
HUC6_ZONES=M:/SWE/WestWide/data/hydro/WW_HUC6_albn83_ras_msked.tif
#
WW_REGION_ZONES=M:/SWE/WestWide/data/hydro/WW_Regions_albn83_v2.tif
SNM_REGION_ZONES=M:/SWE/WestWide/data/hydro/SNM/dwr_regions_albn83.tif
#
SNM_BAND_ZONES=M:/SWE/WestWide/data/hydro/SNM/dwr_band_basins_geoSort_albn83_delin.tif
